  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "x-lenso-sensitive": true
    },
    "code_verifier": {
      "type": "string",
      "x-lenso-sensitive": true
    },
    "code_challenge": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",

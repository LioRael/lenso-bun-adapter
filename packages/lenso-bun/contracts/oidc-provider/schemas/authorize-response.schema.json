{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "x-lenso-sensitive": true
    },
    "redirect_uri": {
      "type": "string"
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "code",
    "redirect_uri",
    "state",
    "expires_at"
  ],
  "additionalProperties": false
}

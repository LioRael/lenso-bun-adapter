{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "disabled"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "disabled_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "subject",
    "status",
    "reason",
    "disabled_until"
  ],
  "additionalProperties": false
}

{
  "name": "@lenso/bun",
  "version": "0.3.1",
  "description": "The supported Bun authoring SDK for Lenso Plugins and official Capability projections.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-bun-adapter.git",
    "directory": "packages/lenso-bun"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./capabilities/jobs": {
      "types": "./dist/capabilities/jobs.d.ts",
      "import": "./dist/capabilities/jobs.js",
      "default": "./dist/capabilities/jobs.js"
    },
    "./capabilities/*": {
      "types": "./dist/capabilities/*.d.ts",
      "import": "./dist/capabilities/*.js",
      "default": "./dist/capabilities/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "capabilities.lock.json",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "capabilities:check": "node scripts/capabilities.mjs check",
    "capabilities:sync": "node scripts/capabilities.mjs sync",
    "prepack": "bun run build",
    "smoke": "bun test test/package.test.ts",
    "test": "bun test test"
  },
  "dependencies": {
    "@lenso/bun-plugin": "0.2.1",
    "@lenso/contract-runtime": "0.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.2.21"
  }
}
